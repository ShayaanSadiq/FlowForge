# Copy to .env for local overrides. Do NOT commit real secrets.

# MongoDB (local Docker Compose uses the mongo service)
SPRING_DATA_MONGODB_URI=mongodb://mongo:27017/flowforge
SPRING_DATA_MONGODB_DATABASE=flowforge

# JWT signing key — use a random 32+ character string in production
FLOWFORGE_JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Spring profile: dev (local) or prod (AWS)
SPRING_PROFILES_ACTIVE=dev

# Optional: extra CORS origins for the API (comma-separated patterns)
# Example: https://flowforge.example.com,https://www.flowforge.example.com
FLOWFORGE_CORS_ORIGINS=

# AWS deploy script inputs (scripts/push-ecr.sh)
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1

# Smoke test script inputs (scripts/verify-deployment.sh)
API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
TEST_EMAIL=
TEST_PASSWORD=
